{
  "name": "broccoli-queue",
  "version": "0.1.0",
  "description": "High-throughput in-process job queues on BroccoliDB tables",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "bench": "npm run build && node bench/throughput.js",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "peerDependencies": {
    "@noorm/broccolidb": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@noorm/broccolidb": "git+https://github.com/CardSorting/ABroccoliDB.git#f085f3f",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "files": [
    "dist",
    "dashboard",
    "bench",
    "README.md",
    "docs",
    "LICENSE"
  ]
}
